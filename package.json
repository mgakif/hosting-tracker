{
  "name": "hosting-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "db:migrate": "wrangler d1 migrations apply hosting-tracker --remote",
    "db:migrate:local": "wrangler d1 migrations apply hosting-tracker --local",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.474.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "wrangler": "^4.152.0"
  }
}
