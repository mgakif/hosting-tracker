{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hosting-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",

  // Vite çıktısı (dist) statik olarak sunulur; /api/* istekleri Worker'a gelir.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hosting-tracker",
      "database_id": "0bd8dd91-1f10-4592-8e14-6a9539da1506",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare panelinde Workers > hosting-tracker > Logs altında cron çalışmaları görünür.
  "observability": {
    "enabled": true
  },

  // Her gün 06:00 UTC (09:00 TR) Slack hatırlatıcısı.
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  "vars": {
    "ADMIN_EMAIL": "mgakif@gmail.com"
  }
  // Gizli değerler (wrangler secret put ile):
  //   ADMIN_PASSWORD  - panel giriş şifresi
  //   SESSION_SECRET  - oturum çerezini imzalamak için uzun rastgele bir metin
}
